# Required for production
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# URL where the app is reachable (used by NextAuth for callbacks)
NEXTAUTH_URL=http://localhost:3008

# Optional — override DB/Redis if not using docker-compose defaults
# DATABASE_URL=postgresql://buildos:buildos@postgres:5432/buildos
# REDIS_URL=redis://redis:6379

# Optional — inject into HTTPS GitHub clone URLs for private repos
# GITHUB_TOKEN=ghp_...

# Optional — Cloudflare DNS automation
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
